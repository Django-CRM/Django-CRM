# Environment variables
# Copy this file to .env and adjust as needed:  cp .env.example .env

SECRET_KEY="django-insecure-dev-key-please-change-in-production"
ENV_TYPE="dev"
DEBUG=True
DOMAIN_NAME="http://localhost:8000"

# The web app's base URL. Every link this system emails is built from it: the
# magic-link sign-in URL, the customer's invoice and estimate portal links, the
# CSAT survey, and the internal "assigned to you" notifications. Outside dev
# (ENV_TYPE other than "dev") a loopback value is refused at startup, because
# left at this default it mails customers a link to their own machine.
FRONTEND_URL="http://localhost:5181"

# S3-compatible object storage (Tigris for production)
# Keep the bucket private. Use a bucket-scoped key with read/write access.
AWS_BUCKET_NAME=""
TIGRIS_ACCESS_KEY_ID=""
TIGRIS_SECRET_ACCESS_KEY=""
# Optional AWS IAM credentials for SES inbound S3 retrieval only. If omitted,
# the runtime must have an AWS instance role when large inbound emails are used.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT_URL="https://t3.storage.dev"
AWS_S3_REGION_NAME="auto"
AWS_S3_ADDRESSING_STYLE="virtual"

# DB
DBNAME="crm_db"
DBUSER="postgres"
DBPASSWORD="postgres"
DBHOST="localhost"
DBPORT="5432"

# Sentry (optional)
SENTRY_DSN=""

# Celery
# For Upstash production, set UPSTASH_REDIS_URL to the TCP rediss:// URL from
# Upstash > database > Connect > TCP. It supplies both broker and result backend.
# Do not use UPSTASH_REDIS_REST_URL / REST token here.
UPSTASH_REDIS_URL=""
# Optional explicit overrides. Leave these commented to use UPSTASH_REDIS_URL
# when provided, or the local redis://localhost:6379/0 defaults otherwise.
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_REDIS_POLLING_INTERVAL=10
CELERY_RESULT_EXPIRES=86400

# Google OAuth (optional: leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Phone push for lead alerts (optional: a Firebase service-account JSON file;
# blank leaves push off). See docs/features/lead-alerts.md.
FCM_SERVICE_ACCOUNT_FILE=""

# Email
# Production (ENV_TYPE=prod) selects Resend automatically and requires both
# RESEND_API_KEY and a sender on a domain verified in Resend.
# Set these in Render; never commit API keys or paste them into chat.
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
RESEND_API_KEY=""
# Optional QStash async delivery for magic-link / OTP email. Set all four
# QStash values in Render; callback URL must be the exact public HTTPS endpoint.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_CALLBACK_URL="https://your-api-host/api/auth/magic-link/deliver/"
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and backed up; rotating it makes queued OTPs unreadable.
MAGIC_LINK_ENCRYPTION_KEY=""
DEFAULT_FROM_EMAIL="noreply@localhost"
ADMIN_EMAIL="admin@localhost"

# SMTP (only read when EMAIL_BACKEND is "django.core.mail.backends.smtp.EmailBackend").
# For Mailtrap's Email Sandbox: EMAIL_HOST="sandbox.smtp.mailtrap.io", EMAIL_PORT=2525,
# EMAIL_USE_TLS=True; see docs/self-hosting/email-and-celery.md.
EMAIL_HOST=""
EMAIL_PORT=
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS=False

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5181,http://127.0.0.1:5181
CSRF_TRUSTED_ORIGINS=http://localhost:5181

# Set to True only when TLS is terminated by a proxy in front of Django and that
# proxy is the only way in. It makes Django trust X-Forwarded-Proto, which is
# what lets the HSTS settings emit a header at all. Leave False for direct HTTP
# or the header becomes something any caller can forge.
TRUST_PROXY_SSL_HEADER=False

# Reverse proxies in front of Django that append to X-Forwarded-For (nginx with
# $proxy_add_x_forwarded_for is one). Every recorded client IP (audit log, web
# form submissions, estimate acceptance, sign-in tokens) and every per-IP
# throttle trusts only that many entries from the right; unset uses REMOTE_ADDR.
# Leave it unset if the app server already resolves the client from trusted
# proxies (uvicorn --proxy-headers --forwarded-allow-ips=127.0.0.1). Set it to 1
# when REMOTE_ADDR is the proxy itself (gunicorn behind one nginx), or every
# visitor shares the proxy's throttle bucket. Never set it on top of uvicorn's
# proxy handling: SvelteKit-relayed requests would then all count as the relay.
NUM_PROXIES=

# Shared secret with the SvelteKit servers that relay anonymous visitors (the
# web app's sign-in pages, help center and estimate portal, the marketing
# site's contact form). A request carrying it in X-BottleCRM-Relay-Secret is believed about
# the visitor address in X-BottleCRM-Client-IP, so each visitor gets their own
# per-IP throttle bucket and recorded address instead of the relay's. Set the
# same value as RELAY_SECRET on each SvelteKit service. At least 32 characters
# or the app refuses to start; leave empty to turn it off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RELAY_SECRET=

# Shared cache. Required in production for DRF throttling to be enforced across
# workers rather than per process. Without it the public web form rate limits
# are per gunicorn worker and reset on restart.
CACHE_URL=""

# Public web form submission limits (issue #634). The first is per client IP
# per form; the second is per form across all clients and is the layer that
# X-Forwarded-For rotation cannot evade.
WEBFORM_THROTTLE_IP="10/hour"
WEBFORM_THROTTLE_GLOBAL="200/day"

# Lead webhook post limits, per webhook across all senders.
LEAD_INTAKE_THROTTLE_MINUTE="120/min"
LEAD_INTAKE_THROTTLE_DAY="5000/day"

# Generated inbound addresses: the domain they are made under (its MX points at
# SES receiving) and the SNS topic its receipt rule publishes to. Set both to
# offer "Generate an address"; leave both empty to have admins type addresses.
INBOUND_EMAIL_DOMAIN=""
INBOUND_EMAIL_TOPIC_ARN=""

# Magic-link and customer portal sign-in request limits. The first of each is
# per client IP; without RELAY_SECRET every web sign-in shares the SvelteKit
# server's bucket, so keep it roomy. The global one pauses sign-in email for
# everyone when reached; the portal one, for one org.
MAGIC_LINK_THROTTLE_IP="30/hour"
MAGIC_LINK_THROTTLE_GLOBAL="300/hour"
PORTAL_LOGIN_THROTTLE_IP="30/hour"
PORTAL_LOGIN_THROTTLE_ORG="100/hour"

# Contacts and leads import limit, per signed-in user, shared by the preview
# and commit endpoints. Each upload parses up to 5,000 rows.
IMPORT_THROTTLE="30/minute"
