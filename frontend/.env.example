# Google OAuth (client_id only - secret is on backend)
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_LOGIN_DOMAIN="http://localhost:5181"

# Django API URL (PUBLIC_ prefix makes it available in both server and browser)
PUBLIC_DJANGO_API_URL=http://localhost:8000

# Sentry (only set in production, omit locally to disable Sentry)
# PUBLIC_SENTRY_DSN="https://your-dsn.ingest.sentry.io/your-project"

# Environment
NODE_ENV=development

# Relayed visitor addresses (optional locally; deploy-frontend.sh requires them
# in hosted production). Several pages reach the API from this server; with
# RELAY_SECRET set they also send the visitor's address, signed with it, so
# each visitor gets their own per-IP throttle bucket and recorded address. Must equal RELAY_SECRET on the Django
# API and on bottlecrm.io. Private: never prefix it with PUBLIC_.
# RELAY_SECRET=
#
# Behind nginx in production, adapter-node only knows the visitor if told which
# header nginx writes. Without these, getClientAddress() is nginx itself.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
#
# adapter-node binds 0.0.0.0 by default. Bind it to loopback in production so
# only nginx can reach it: reachable directly, a caller writes its own
# X-Forwarded-For and the relay signs it as the visitor.
# HOST=127.0.0.1
